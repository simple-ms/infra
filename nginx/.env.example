# Nginx Environment Variables
# Copy this file to .env and adjust values for your environment

# ===========================================
# SERVICE HOSTS
# ===========================================
# Docker Compose: Use service names
# Kubernetes: Use service DNS (e.g., auth-service.default.svc.cluster.local)

AUTH_SERVICE_HOST=auth-api
USER_SERVICE_HOST=user-api
PRODUCT_SERVICE_HOST=product-api
ORDER_SERVICE_HOST=order-api
PAYMENT_SERVICE_HOST=payment-api

# ===========================================
# SERVICE PORTS
# ===========================================
AUTH_SERVICE_PORT=8000
USER_SERVICE_PORT=8000
PRODUCT_SERVICE_PORT=8000
ORDER_SERVICE_PORT=8000
PAYMENT_SERVICE_PORT=8000

# ===========================================
# CORS CONFIGURATION
# ===========================================
# Allowed origin for CORS requests
# Development: http://localhost:5173
# Production: https://yourdomain.com
CORS_ORIGIN=http://localhost:5173

# ===========================================
# RATE LIMITING
# ===========================================
# Format: <number>r/s (requests per second) or <number>r/m (requests per minute)

# Auth endpoints (login, register) - stricter to prevent brute force
RATE_LIMIT_AUTH=10r/s
RATE_LIMIT_AUTH_BURST=20

# General API endpoints
RATE_LIMIT_API=100r/s
RATE_LIMIT_API_BURST=50

# Strict endpoints (payments, orders)
RATE_LIMIT_STRICT=50r/s
RATE_LIMIT_STRICT_BURST=30

# ===========================================
# REQUEST LIMITS
# ===========================================
# Maximum request body size (e.g., 10M, 50M, 100M)
CLIENT_MAX_BODY_SIZE=10M

# Timeouts in seconds
CLIENT_BODY_TIMEOUT=12
CLIENT_HEADER_TIMEOUT=12
SEND_TIMEOUT=10

# ===========================================
# PROXY TIMEOUTS
# ===========================================
PROXY_CONNECT_TIMEOUT=5
PROXY_SEND_TIMEOUT=10
PROXY_READ_TIMEOUT=10

# ===========================================
# COMPRESSION
# ===========================================
# Gzip compression level (1-9, higher = more compression but more CPU)
GZIP_COMP_LEVEL=6

# Minimum file size to compress (in bytes)
GZIP_MIN_LENGTH=1024

# ===========================================
# KEEPALIVE
# ===========================================
KEEPALIVE_TIMEOUT=65
KEEPALIVE_REQUESTS=100

# ===========================================
# WORKER CONFIGURATION
# ===========================================
# Number of worker connections (256, 512, 1024, etc.)
WORKER_CONNECTIONS=256

# ===========================================
# LOGGING
# ===========================================
# Log level: debug, info, notice, warn, error, crit
ERROR_LOG_LEVEL=warn
